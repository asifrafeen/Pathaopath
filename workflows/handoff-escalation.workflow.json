    {
      "id": "548cef2c87024c4e83d4c9fae71c66a2",
      "name": "Keep only the stale ones",
      "category": "transform",
      "type": "code",
      "version": "v1",
      "position": {
        "x": 790,
        "y": 100
      },
      "handle": null,
      "parameters": {
        "mode": "all",
        "language": "js",
        "script": "const res = $json.output || {};\nconst items = ((res.getParcelMovements || {}).items) || [];\nconst now = Date.now();\nconst HOUR = 3600000;\nconst out = [];\nfor (const m of items) {\n  // Planned but never collected.\n  if (m.status === \"planned\" && m.CreatedDate && now - new Date(m.CreatedDate).getTime() > 4 * HOUR) {\n    out.push({ movementId: m.ItemId, caseId: m.caseId, parcelId: m.parcelId,\n      ownerHubOrgId: m.fromHubOrgId || \"\", trackingNumber: m.trackingNumber || \"\",\n      rider: (m.assignedRider && m.assignedRider.name) || \"unassigned\",\n      kind: \"never picked up\",\n      hours: Math.round((now - new Date(m.CreatedDate).getTime()) / HOUR) });\n  }\n  // Collected but never delivered anywhere.\n  if (m.status === \"picked_up\" && m.pickupAcknowledgedAt &&\n      now - new Date(m.pickupAcknowledgedAt).getTime() > 12 * HOUR) {\n    out.push({ movementId: m.ItemId, caseId: m.caseId, parcelId: m.parcelId,\n      ownerHubOrgId: m.fromHubOrgId || \"\", trackingNumber: m.trackingNumber || \"\",\n      rider: (m.assignedRider && m.assignedRider.name) || \"unassigned\",\n      kind: \"in transit with no arrival\",\n      hours: Math.round((now - new Date(m.pickupAcknowledgedAt).getTime()) / HOUR) });\n  }\n}\nreturn out;",
        "continueOnError": false
      },
      "settings": {},
      "pinData": null
    },
