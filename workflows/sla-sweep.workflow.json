    {
      "id": "b04e9fb06c104fc2ba6d9aa2cc0b58ae",
      "name": "Keep only the ones past due",
      "category": "transform",
      "type": "code",
      "version": "v1",
      "position": {
        "x": 790,
        "y": 100
      },
      "handle": null,
      "parameters": {
        "mode": "all",
        "language": "js",
        "script": "const res = $json.output || {};\nconst items = ((res.getExceptionCases || {}).items) || [];\nconst now = Date.now();\nreturn items\n  .filter(c => c.slaDueAt && new Date(c.slaDueAt).getTime() < now)\n  .map(c => ({\n    caseId: c.ItemId,\n    parcelId: c.parcelId,\n    ownerHubOrgId: c.ownerHubOrgId || \"\",\n    hubCode: (c.ownerHub && c.ownerHub.code) || \"\",\n    trackingNumber: (c.parcel && c.parcel.trackingNumber) || \"\",\n    hoursOver: Math.round((now - new Date(c.slaDueAt).getTime()) / 3600000)\n  }));",
        "continueOnError": false
      },
      "settings": {},
      "pinData": null
    },
