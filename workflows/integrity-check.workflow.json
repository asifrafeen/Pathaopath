    {
      "id": "fe18bfb79c024d3bbea174e264d6c5ea",
      "name": "Find violations",
      "category": "transform",
      "type": "code",
      "version": "v1",
      "position": {
        "x": 790,
        "y": 100
      },
      "handle": null,
      "parameters": {
        "mode": "all",
        "language": "js",
        "script": "const res = $json.output || {};\nconst cases = ((res.cases || {}).items) || [];\nconst movements = ((res.movements || {}).items) || [];\nconst ownership = ((res.ownership || {}).items) || [];\n\nconst countBy = (rows, key) => rows.reduce((acc, r) => {\n  const k = r[key]; if (!k) return acc; acc[k] = (acc[k] || 0) + 1; return acc;\n}, {});\n\nconst violations = [];\n\n// 1. At most one open case per parcel.\nconst perParcel = countBy(cases, \"parcelId\");\nfor (const [parcelId, n] of Object.entries(perParcel)) {\n  if (n > 1) {\n    const c = cases.find(x => x.parcelId === parcelId);\n    violations.push({ caseId: c.ItemId, parcelId, ownerHubOrgId: c.ownerHubOrgId || \"\",\n      rule: \"multiple open cases for one parcel\", count: n });\n  }\n}\n\n// 2. At most one active movement per case.\nconst perCase = countBy(movements, \"caseId\");\nfor (const [caseId, n] of Object.entries(perCase)) {\n  if (n > 1) {\n    const c = cases.find(x => x.ItemId === caseId) || {};\n    violations.push({ caseId, parcelId: c.parcelId || \"\", ownerHubOrgId: c.ownerHubOrgId || \"\",\n      rule: \"multiple active movements for one case\", count: n });\n  }\n}\n\n// 3. Exactly one current ownership period.\nconst ownCounts = countBy(ownership, \"caseId\");\nfor (const [caseId, n] of Object.entries(ownCounts)) {\n  if (n > 1) {\n    const c = cases.find(x => x.ItemId === caseId) || {};\n    violations.push({ caseId, parcelId: c.parcelId || \"\", ownerHubOrgId: c.ownerHubOrgId || \"\",\n      rule: \"overlapping ownership periods\", count: n });\n  }\n}\n\n// 4. The worse inverse: an open case owned by nobody. This is the invariant the whole\n//    product rests on, and the reconciliation sweep can leave it if an arrival was\n//    interrupted before the receiving hub's period was ever written.\nfor (const c of cases) {\n  if (!ownCounts[c.ItemId]) {\n    violations.push({ caseId: c.ItemId, parcelId: c.parcelId || \"\", ownerHubOrgId: c.ownerHubOrgId || \"\",\n      rule: \"open case with no current owner\", count: 0 });\n  }\n}\n\nreturn violations;",
        "continueOnError": false
      },
      "settings": {},
      "pinData": null
    },
